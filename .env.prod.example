# Ejemplo de configuración local para un build de PRODUCCIÓN.
# No contiene secretos. Los valores reales deben obtenerse de la Web App de Firebase PROD.
VITE_APP_ENV=prod
VITE_BRAND_LOGO_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=ccnsa-web-prod
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
