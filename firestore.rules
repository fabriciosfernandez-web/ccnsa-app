rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && currentUser().data.active == true;
    }

    function hasRole(role) {
      return activeUser() && currentUser().data.role == role;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isTreasury() {
      return hasRole('TESORERIA');
    }

    function isReadOnlyStaff() {
      return hasRole('CONSULTA');
    }

    function isStaff() {
      return isAdmin() || isTreasury() || isReadOnlyStaff();
    }

    function isSocio() {
      return hasRole('SOCIO');
    }

    function currentSocioId() {
      return currentUser().data.socioId;
    }

    function canCreateFinanceMovement() {
      return (isAdmin() || isTreasury())
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.importe is number
        && request.resource.data.importe > 0
        && request.resource.data.estado == 'REGISTRADO';
    }

    function canVoidFinanceMovement() {
      return (isAdmin() || isTreasury())
        && resource.data.estado == 'REGISTRADO'
        && request.resource.data.estado == 'ANULADO'
        && request.resource.data.anuladoPorUid == request.auth.uid
        && request.resource.data.anulacionMotivo is string
        && request.resource.data.anulacionMotivo.size() >= 5
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado',
          'anulacionMotivo',
          'anuladoPorUid',
          'anuladoPorNombre',
          'anuladoPorRol',
          'anuladoAt',
          'updatedAt'
        ]);
    }

    function canCreateActividad() {
      return (isAdmin() || isTreasury())
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.fechaInicio is string
        && request.resource.data.estado in ['PLANIFICADA', 'ACTIVA'];
    }

    function canUpdateActividad() {
      return (isAdmin() || isTreasury())
        && resource.data.estado in ['PLANIFICADA', 'ACTIVA']
        && request.resource.data.estado in ['PLANIFICADA', 'ACTIVA', 'CERRADA', 'CANCELADA']
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado',
          'updatedAt',
          'updatedByUid',
          'updatedByNombre'
        ]);
    }

    function canCreateActividadMovement() {
      return (isAdmin() || isTreasury())
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actividadId is string
        && request.resource.data.tipo in ['INGRESO', 'EGRESO']
        && request.resource.data.importe is number
        && request.resource.data.importe > 0
        && request.resource.data.estado == 'REGISTRADO'
        && request.resource.data.financeCollection in ['ingresos', 'egresos']
        && request.resource.data.financeMovementId is string;
    }

    function canVoidActividadMovement() {
      return (isAdmin() || isTreasury())
        && resource.data.estado == 'REGISTRADO'
        && request.resource.data.estado == 'ANULADO'
        && request.resource.data.anuladoPorUid == request.auth.uid
        && request.resource.data.anulacionMotivo is string
        && request.resource.data.anulacionMotivo.size() >= 5
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado',
          'anulacionMotivo',
          'anuladoPorUid',
          'anuladoPorNombre',
          'anuladoPorRol',
          'anuladoAt',
          'updatedAt'
        ]);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create, update, delete: if isAdmin();
    }

    match /socios/{socioId} {
      allow read: if isStaff() || (isSocio() && currentSocioId() == socioId);
      allow create, update, delete: if isAdmin();
    }

    match /obligaciones/{obligacionId} {
      allow read: if isStaff() || (isSocio() && resource.data.socioId == currentSocioId());
      allow create: if (isAdmin() || isTreasury())
        && request.resource.data.socioId is string
        && request.resource.data.importe is number
        && request.resource.data.importe > 0;
      allow update, delete: if isAdmin() || isTreasury();
    }

    match /pagos/{pagoId} {
      allow read: if isStaff() || (isSocio() && resource.data.socioId == currentSocioId());
      allow create: if (isAdmin() || isTreasury())
        && request.resource.data.socioId is string
        && request.resource.data.importe is number
        && request.resource.data.importe > 0;
      allow update, delete: if isAdmin() || isTreasury();
    }

    match /aplicaciones_pago/{aplicacionId} {
      allow read: if isStaff() || (isSocio() && resource.data.socioId == currentSocioId());
      allow create: if (isAdmin() || isTreasury())
        && request.resource.data.socioId is string
        && request.resource.data.pagoId is string
        && request.resource.data.obligacionId is string
        && request.resource.data.importe is number
        && request.resource.data.importe > 0
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /ingresos/{ingresoId} {
      allow read: if isStaff();
      allow create: if canCreateFinanceMovement();
      allow update: if canVoidFinanceMovement();
      allow delete: if false;
    }

    match /egresos/{egresoId} {
      allow read: if isStaff();
      allow create: if canCreateFinanceMovement();
      allow update: if canVoidFinanceMovement();
      allow delete: if false;
    }

    match /actividades/{actividadId} {
      allow read: if isStaff()
        || (isSocio() && resource.data.estado in ['PLANIFICADA', 'ACTIVA']);
      allow create: if canCreateActividad();
      allow update: if canUpdateActividad();
      allow delete: if false;
    }

    match /movimientos_actividad/{movimientoId} {
      allow read: if isStaff();
      allow create: if canCreateActividadMovement();
      allow update: if canVoidActividadMovement();
      allow delete: if false;
    }

    match /configuracion/{configId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /tarifas_cuotas/{tarifaId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /reglas_cobro/{reglaId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /excepciones_cobro/{excepcionId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /categoria_historial/{cambioId} {
      allow read: if isStaff();
      allow create: if isAdmin()
        && request.resource.data.socioId is string
        && request.resource.data.categoriaAnterior is string
        && request.resource.data.categoriaNueva is string
        && request.resource.data.vigenteDesde is string
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isStaff()
        || (isSocio() && resource.data.socioId == currentSocioId());

      allow create: if (isAdmin() || isTreasury())
        && request.resource.data.socioId is string
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'UNREAD'
        && request.resource.data.kind in [
          'ACCOUNT_STATEMENT_READY',
          'PAYMENT_POSTED',
          'OBLIGATION_POSTED',
          'OVERDUE_REMINDER',
          'GENERAL_NOTICE'
        ];

      allow update: if isSocio()
        && resource.data.socioId == currentSocioId()
        && request.resource.data.socioId == resource.data.socioId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readAt'])
        && request.resource.data.status == 'READ';

      allow delete: if false;
    }

    match /notification_preferences/{socioId} {
      allow read: if isStaff() || (isSocio() && currentSocioId() == socioId);

      allow create, update: if isSocio()
        && currentSocioId() == socioId
        && request.resource.data.socioId == socioId;

      allow delete: if false;
    }

    match /push_subscriptions/{subscriptionId} {
      allow read: if isSocio()
        && resource.data.socioId == currentSocioId()
        && resource.data.uid == request.auth.uid;

      allow create: if isSocio()
        && request.resource.data.socioId == currentSocioId()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() > 20
        && request.resource.data.enabled == true;

      allow update: if isSocio()
        && resource.data.socioId == currentSocioId()
        && resource.data.uid == request.auth.uid
        && request.resource.data.socioId == resource.data.socioId
        && request.resource.data.uid == resource.data.uid;

      allow delete: if isSocio()
        && resource.data.socioId == currentSocioId()
        && resource.data.uid == request.auth.uid;
    }

    match /notification_deliveries/{deliveryId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /audit_log/{logId} {
      allow read: if isStaff();
      allow create: if (isAdmin() || isTreasury())
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
