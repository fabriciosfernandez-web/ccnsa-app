rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && currentUser().data.active == true;
    }

    function hasRole(role) {
      return activeUser() && currentUser().data.role == role;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isTreasury() {
      return hasRole('TESORERIA');
    }

    function isReadOnlyStaff() {
      return hasRole('CONSULTA');
    }

    function isStaff() {
      return isAdmin() || isTreasury() || isReadOnlyStaff();
    }

    function isSocio() {
      return hasRole('SOCIO');
    }

    function currentSocioId() {
      return currentUser().data.socioId;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create, update, delete: if isAdmin();
    }

    match /socios/{socioId} {
      allow read: if isStaff() || (isSocio() && currentSocioId() == socioId);
      allow create, update, delete: if isAdmin();
    }

    match /obligaciones/{obligacionId} {
      allow read: if isStaff() || (isSocio() && resource.data.socioId == currentSocioId());
      allow create: if (isAdmin() || isTreasury())
        && request.resource.data.socioId is string
        && request.resource.data.importe is number
        && request.resource.data.importe > 0;
      allow update, delete: if isAdmin() || isTreasury();
    }

    match /pagos/{pagoId} {
      allow read: if isStaff() || (isSocio() && resource.data.socioId == currentSocioId());
      allow create: if (isAdmin() || isTreasury())
        && request.resource.data.socioId is string
        && request.resource.data.importe is number
        && request.resource.data.importe > 0;
      allow update, delete: if isAdmin() || isTreasury();
    }

    match /aplicaciones_pago/{aplicacionId} {
      allow read: if isStaff() || (isSocio() && resource.data.socioId == currentSocioId());
      allow create: if (isAdmin() || isTreasury())
        && request.resource.data.socioId is string
        && request.resource.data.pagoId is string
        && request.resource.data.obligacionId is string
        && request.resource.data.importe is number
        && request.resource.data.importe > 0
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /ingresos/{ingresoId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin() || isTreasury();
    }

    match /egresos/{egresoId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin() || isTreasury();
    }

    match /actividades/{actividadId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin() || isTreasury();
    }

    match /movimientos_actividad/{movimientoId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin() || isTreasury();
    }

    match /configuracion/{configId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /tarifas_cuotas/{tarifaId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /reglas_cobro/{reglaId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /excepciones_cobro/{excepcionId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /categoria_historial/{cambioId} {
      allow read: if isStaff();
      allow create: if isAdmin()
        && request.resource.data.socioId is string
        && request.resource.data.categoriaAnterior is string
        && request.resource.data.categoriaNueva is string
        && request.resource.data.vigenteDesde is string
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isStaff()
        || (isSocio() && resource.data.socioId == currentSocioId());

      allow create: if (isAdmin() || isTreasury())
        && request.resource.data.socioId is string;

      allow update: if isSocio()
        && resource.data.socioId == currentSocioId()
        && request.resource.data.socioId == resource.data.socioId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readAt'])
        && request.resource.data.status == 'READ';

      allow delete: if false;
    }

    match /notification_preferences/{socioId} {
      allow read: if isStaff() || (isSocio() && currentSocioId() == socioId);

      allow create, update: if isSocio()
        && currentSocioId() == socioId
        && request.resource.data.socioId == socioId;

      allow delete: if false;
    }

    match /notification_deliveries/{deliveryId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /audit_log/{logId} {
      allow read: if isStaff();
      allow create: if (isAdmin() || isTreasury())
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
